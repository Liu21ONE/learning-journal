   "source": [
    "#变量与类型\n",
    "name = \"llc\"\n",
    "age = 20\n",
    "scores = [85,92,78,90,88]\n",
    "print(f\"{name}的平均分是{sum(scores)/len(scores)}\")\n",
    "#列表推导式\n",
    "even_scores = [s for s in scores if s>=90]\n",
    "print(f\"90分以上的成绩:{even_scores}\")\n",
    "#字典\n",
    "student = {\"name\":name,\"age\":age,\"scores\":scores}\n",
    "print(student)"
   ]
